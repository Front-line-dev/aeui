{
  "name": "a-easy-ui",
  "version": "0.1.0-alpha.1",
  "type": "module",
  "description": "A lightweight, custom frontend framework",
  "main": "dist/aeui.cjs",
  "module": "dist/aeui.esm.js",
  "types": "types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/aeui.esm.js",
      "require": "./dist/aeui.cjs"
    },
    "./babel-plugin": {
      "types": "./types/babel-plugin.d.ts",
      "import": "./dist/babel-plugin.js",
      "require": "./dist/babel-plugin.cjs"
    },
    "./vite": {
      "types": "./types/vite.d.ts",
      "import": "./dist/vite-plugin.js",
      "require": "./dist/vite-plugin.cjs"
    }
  },
  "typesVersions": {
    "*": {
      "babel-plugin": [
        "types/babel-plugin.d.ts"
      ],
      "vite": [
        "types/vite.d.ts"
      ],
      "*": [
        "types/index.d.ts"
      ]
    }
  },
  "sideEffects": false,
  "files": [
    "dist/aeui.cjs",
    "dist/aeui.cjs.map",
    "dist/aeui.esm.js",
    "dist/aeui.esm.js.map",
    "dist/babel-plugin.cjs",
    "dist/babel-plugin.cjs.map",
    "dist/babel-plugin.js",
    "dist/babel-plugin.js.map",
    "dist/vite-plugin.cjs",
    "dist/vite-plugin.cjs.map",
    "dist/vite-plugin.js",
    "dist/vite-plugin.js.map",
    "src",
    "types"
  ],
  "scripts": {
    "build": "rollup -c",
    "test": "npm --prefix ../../example/test test",
    "typecheck": "tsc -p tsconfig.types.json --noEmit",
    "prepack": "npm run build"
  },
  "keywords": [
    "frontend",
    "framework",
    "ui"
  ],
  "license": "ISC",
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^16.0.3",
    "rollup": "^4.63.1",
    "typescript": "^5.9.3",
    "@types/node": "^22.0.0"
  },
  "dependencies": {
    "@babel/core": "^7.29.7",
    "@babel/plugin-transform-react-jsx": "^7.29.7",
    "parse5": "^8.0.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Front-line-dev/aeui.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/Front-line-dev/aeui#readme",
  "bugs": {
    "url": "https://github.com/Front-line-dev/aeui/issues"
  },
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "publishConfig": {
    "access": "public",
    "tag": "next"
  },
  "peerDependencies": {
    "vite": "^8.2.2"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  }
}
