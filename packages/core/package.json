{
  "name": "aeui",
  "version": "0.0.1",
  "type": "module",
  "description": "A lightweight, custom frontend framework",
  "main": "dist/aeui.js",
  "module": "dist/aeui.esm.js",
  "exports": {
    ".": {
      "import": "./dist/aeui.esm.js",
      "require": "./dist/aeui.js"
    },
    "./babel-plugin": {
      "import": "./dist/babel-plugin.js",
      "require": "./dist/babel-plugin.cjs"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "rollup -c",
    "prepublishOnly": "npm run build",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "frontend",
    "framework",
    "ui"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^16.0.3",
    "rollup": "^4.53.3"
  }
}
