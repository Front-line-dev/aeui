{
  "compilerOptions": {
    "strict": true,
    "target": "ES2020",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "jsx": "react-jsx",
    "jsxImportSource": "aeui",
    "lib": [
      "ES2020",
      "DOM",
      "ESNext.Disposable"
    ],
    "skipLibCheck": false,
    "noEmit": true
  },
  "include": [
    "types/**/*.d.ts",
    "type-tests/**/*.ts",
    "type-tests/**/*.tsx"
  ]
}
